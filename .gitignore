/build/
*.user
*.qmlc
*.jsc
__pycache__/
*.pyc

# Rust / GTK rewrite build artifacts (normally redirected to the persistent
# cache via CARGO_TARGET_DIR, but ignore a local ./target defensively)
/target/
/gtk/target/
Cargo.lock.bak

# Never commit a private abuild signing key dropped in the working tree; only the
# .rsa.pub half under packaging/keys/ is tracked.
*.rsa
