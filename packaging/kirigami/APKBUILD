# Contributor: yoxcu <mick@yoxcu.de>
# Maintainer: yoxcu <mick@yoxcu.de>
#
# TEMPLATE — starting point for a postmarketOS/Alpine package of the KIRIGAMI build
# of the stoandl GUI. The GTK build is a separate package (../gtk/APKBUILD,
# stoandl-gui-gtk) and the two install side by side.
# The release CI rewrites pkgver automatically, so `pkgver=0.1.0` below is just a
# placeholder — a release build is always the tag's version, not this.
# Building by hand: bump pkgver to a released tag, then run `abuild checksum` to
# fill sha512sums (it downloads the release source tarball produced by CI). Verify
# the depends/makedepends names against your Alpine branch (`apk search`) — Qt6 and
# Kirigami package names drift between releases. The build itself is pure Qt6/CMake,
# so it is musl-clean.
pkgname=stoandl-gui
pkgver=0.1.0
pkgrel=0
pkgdesc="Kirigami front-end for the stoandl Pebble companion daemon"
url="https://github.com/yoxcu/stoandl-gui"
arch="all"
license="GPL-3.0-only"
depends="
	qt6-qtbase
	qt6-qtdeclarative
	kirigami
	kirigami-addons
	qqc2-desktop-style
	hicolor-icon-theme
	"
makedepends="
	cmake
	samurai
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	kirigami-dev
	"
# Both variants build from the one whole-repo release tarball (CI's git archive,
# prefix stoandl-gui-$pkgver/), so the source filename and builddir are pinned to
# that prefix — independent of $pkgname.
source="stoandl-gui-$pkgver.tar.gz::https://github.com/yoxcu/stoandl-gui/releases/download/v$pkgver/stoandl-gui-$pkgver.tar.gz"
builddir="$srcdir/stoandl-gui-$pkgver"

build() {
	# The CMake project lives in kirigami/ (it installs the desktop file, metainfo
	# and this variant's icons from ../data).
	cmake -S kirigami -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBEXECDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums=""  # run `abuild checksum` to populate
